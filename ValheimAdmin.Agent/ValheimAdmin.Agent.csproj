<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ValheimAdmin.Agent</AssemblyName>
    <RootNamespace>ValheimAdmin.Agent</RootNamespace>
    <Version>0.4.0</Version>
    <!-- Lets `dotnet run` use a newer installed runtime; the published agent is self-contained. -->
    <RollForward>Major</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- UseStaticFiles serves the plain files; no precompressed copies. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Logic shared with the plugin, compiled into both. -->
  <ItemGroup>
    <Compile Include="..\ValheimAdmin.Common\**\*.cs" Link="Common\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ValheimAdmin.Agent.Tests" />
    <!-- The panel lives in ..\web (the plugin embeds the same files). The agent serves it from
         wwwroot next to the exe, also when run from bin. -->
    <Content Include="..\web\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

</Project>
